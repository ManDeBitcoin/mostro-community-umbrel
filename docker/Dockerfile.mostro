# Opt-in integration image. Uses verified official release artifacts, no protocol fork.
FROM debian:bookworm-slim AS download
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl ncurses-base && rm -rf /var/lib/apt/lists/*
RUN set -eu; \
    case "$TARGETARCH" in \
      amd64) artifact=mostrod-x86_64-unknown-linux-musl; checksum=9fa0516a79270dec2dbe074f14cf988c0311a9d56c80f0a00a98e8d579b3cf53 ;; \
      arm64) artifact=mostrod-aarch64-unknown-linux-musl; checksum=034af649fcad9754e23bee91babdb7b2785431a9cba3ffd91c9b45ac3ccc8b3d ;; \
      *) echo 'Unsupported architecture' >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/MostroP2P/mostro/releases/download/v0.18.8/$artifact" -o /mostrod; \
    echo "$checksum  /mostrod" | sha256sum -c -; \
    chmod 755 /mostrod; \
    TERM=xterm /mostrod --version
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates ncurses-base && rm -rf /var/lib/apt/lists/*
COPY --from=download /mostrod /usr/local/bin/mostrod
USER 1000:1000
WORKDIR /data
ENV TERM=xterm
# Deliberately no default settings: integration owner must provision and verify them.
ENTRYPOINT ["mostrod"]
CMD ["-d", "/data"]
